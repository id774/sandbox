<?xml version="1.0" encoding="utf-8"?>
<!--
  onsg8_hello.mxml: Flex window that shows an alert

  Description:
  Define an AIR window whose button shows a greeting with mx.controls.Alert.

  Author: id774 (More info: https://id774.net)
  Source Code: https://github.com/id774/sandbox
  License: The GPL version 3, or LGPL version 3 (Dual License).
  Contact: idnanashi@gmail.com

  Requirements:
  - Adobe Flex Builder or the Flex SDK with AIR, which build this project
-->
<mx:WindowedApplication xmlns:mx="http://www.adobe.com/2006/mxml" layout="vertical">
	<mx:Script>
		<![CDATA[
			import mx.controls.Alert;
			private function button_click():void {
				mx.controls.Alert.show('こんにちは、' + put_name.text + 'さん');
			}
		]]>
	</mx:Script>
	<mx:Label text="Hello_button" />
	<mx:TextInput id="put_name" text="名前いれてね"/>
	<mx:Button label="push!" click="button_click()"/>
</mx:WindowedApplication>
