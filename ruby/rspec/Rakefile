# -*- encoding: utf-8 -*-
# Rakefile: Rake tasks for RSpec and coverage
#
# Description:
# Add lib to the load path and define the default spec task and a coverage
# task, both running spec/**/*_spec.rb with RSpec. The coverage task uses
# rcov.
#
# Author: id774 (More info: https://id774.net)
# Source Code: https://github.com/id774/sandbox
# License: The GPL version 3, or LGPL version 3 (Dual License).
# Contact: idnanashi@gmail.com
#
# Usage:
#     rake
#     rake coverage
#
# Requirements:
# - Ruby with Rake
# - RSpec 2, whose RakeTask still accepts the rcov options, and rcov for the
#   coverage task
#

$:.unshift  File.join(File.dirname(__FILE__), "lib")
require 'rspec/core'
require 'rspec/core/rake_task'
 
task :default => :spec
 
desc "Run all specs in spec directory" # and Generate code coverage
RSpec::Core::RakeTask.new(:spec) do |t|
  t.pattern = "./spec/**/*_spec.rb" # don't need this, it's default.
  t.rspec_opts = ['-c']
end

RSpec::Core::RakeTask.new(:coverage) do |t|
  t.pattern = "./spec/**/*_spec.rb" # don't need this, it's default.
  t.rcov = true
  t.rcov_opts = ['--exclude', 'spec']
end
