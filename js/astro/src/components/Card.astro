---
// Card.astro: Card component with props and a slot
//
// Description:
// Card component that takes its props from Astro.props, renders the caller's
// content through <slot />, and scopes its styles to the component.
// Part of the Astro sample project; see src/pages/index.astro and
// README.md in this directory for setup and requirements.
//
// Author: id774 (More info: https://id774.net)
// Source Code: https://github.com/id774/sandbox
// License: The GPL version 3, or LGPL version 3 (Dual License).
// Contact: idnanashi@gmail.com

interface Props {
  title: string;
  href?: string;
}

// Props come from the component tag, destructured off Astro.props.
const { title, href = '#' } = Astro.props;
---

<article>
  <h3><a href={href}>{title}</a></h3>
  <!-- Whatever the caller put between the tags -->
  <slot />
  <!-- Named slots: <p slot="footer">…</p> on the caller side -->
  <footer><slot name="footer">no footer</slot></footer>
</article>

<style>
  /* Scoped to this component by a generated class; no leakage, no BEM */
  article {
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 0.5em 1em;
    margin-bottom: 1em;
  }
  footer {
    color: #888;
    font-size: 0.85em;
  }
</style>
