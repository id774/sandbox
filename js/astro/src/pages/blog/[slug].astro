---
import Card from '../../components/Card.astro';

// getStaticPaths enumerates the pages to build. Each entry becomes one HTML
// file; `props` is passed to the template so no second fetch is needed.
// (In server output mode this is dropped and Astro.params is read at request
// time instead.)
export async function getStaticPaths() {
  const res = await fetch('https://jsonplaceholder.typicode.com/users');
  const users = (await res.json()) as { id: number; name: string; email: string }[];

  return users.map((user) => ({
    params: { slug: String(user.id) },
    props: { user },
  }));
}

const { user } = Astro.props;
const { slug } = Astro.params;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{user.name}</title>
  </head>
  <body>
    <Card title={user.name} href="/">
      <p>{user.email}</p>
      <p slot="footer">slug: {slug}</p>
    </Card>
    <a href="/">back</a>
  </body>
</html>
